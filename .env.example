# Copy this file to ".env" and fill in your keys. Never commit the real .env.

# --- Groq (LLM scoring) ---
# Get a free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Supabase (resume metadata storage) ---
# Project URL: Supabase dashboard > Project Settings > General > "Project URL"
SUPABASE_URL=https://your-project-ref.supabase.co
#
# IMPORTANT: use the Secret key (new UI) / service_role key (legacy UI) here,
# never the Publishable/anon key. Only the backend (this app) talks to
# Supabase - never a browser - so RLS is enabled on all tables with NO public
# policies, and this elevated key is used because it bypasses RLS for
# trusted backend code.
# Dashboard > Project Settings > API Keys > "Secret keys" section (or the
# "Legacy anon, service_role API keys" tab if your project still uses those).
SUPABASE_KEY=your_secret_or_service_role_key_here

# --- Deployment note ---
# This file (.env) is for LOCAL development only. On Streamlit Community
# Cloud, the same values go in the app's Settings > Secrets box in TOML
# format instead - see Section 6 of Resume_JD_Matcher_Requirements_and_Prompt.md.
